# Renomeie este arquivo para .env.nome-do-cliente
# Exemplo: .env.paula-ardanza, .env.legal-design, etc.
#
# O MCP lê VTURB_ENV_FILE para saber qual arquivo carregar.
# Configure em Claude settings:
#   "env": { "VTURB_ENV_FILE": "F:\\local-mcps\\vturb-mcp\\.env.nome-do-cliente" }

VTURB_API_TOKEN=seu_token_aqui
